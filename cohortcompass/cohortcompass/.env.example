# Copy to .env (never commit). Everything is optional: without a key the demo runs in scripted fallback.
ANTHROPIC_API_KEY=
CC_MODEL_STRONG=claude-sonnet-5-5   # interviews + Ask the Cohort
CC_MODEL_CHEAP=claude-haiku-5-5     # parsing, extraction, moderation, post structuring
CC_LLM_TIMEOUT_MS=20000
CC_MIN_N=5                          # minimum sample before any aggregate is shown
CC_DATA_DIR=                        # default ./data/db
CC_NOW=                             # pin "today" for a reproducible demo, e.g. 2026-11-19T18:00:00-06:00
PORT=5173

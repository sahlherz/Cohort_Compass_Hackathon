{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cohortcompass.app/event-resource/1.0.0",
  "title": "EventResource",
  "description": "Campus/program event, club, office or resource. Real items must carry source_url.",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2,4}_[A-Za-z0-9_-]{3,64}$",
      "description": "Stable, prefixed ID, e.g. rev_0001"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "campus_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "program_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "BBA",
        "MBA",
        "MS",
        "MSF",
        "MSBA",
        "JD",
        "PhD",
        "certificate",
        "other"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "synthetic"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "user_interview",
            "user_form",
            "import",
            "seed",
            "catalog",
            "syllabus",
            "calendar"
          ]
        },
        "synthetic": {
          "type": "boolean",
          "description": "TRUE for demo data. Synthetic records must never be presented as real."
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "interview_id": {
          "type": "string"
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Forward-compatible extension point. Keys MUST start with x_.",
      "patternProperties": {
        "^x_[a-z0-9_]+$": {}
      },
      "additionalProperties": false,
      "default": {}
    },
    "type": {
      "type": "string",
      "enum": [
        "event",
        "career_fair",
        "networking",
        "workshop",
        "speaker",
        "trek",
        "club",
        "office",
        "resource",
        "certificate",
        "degree_program",
        "office_hours"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "description": "ISO 8601 date or date-time"
        },
        "end": {
          "type": "string"
        },
        "recurring": {
          "type": "string",
          "maxLength": 80
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "location_or_url": {
      "type": "string",
      "maxLength": 300
    },
    "audience_tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "prospective",
              "enrolled",
              "heading_out",
              "alumni"
            ],
            "description": "Lifecycle stage (GPP: while enrolled → heading out → after graduation)"
          }
        },
        "track": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interest": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "ICS",
        "RSS",
        "manual",
        "catalog",
        "scrape"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "relationship_nudge": {
      "type": "boolean",
      "description": "Builds relationships (office hours, mixers, coffee chats)"
    },
    "relevance_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "description": "Filled per-profile at recommendation time"
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "id",
    "schema_version",
    "campus_id",
    "program_id",
    "program_type",
    "created_at",
    "provenance",
    "type",
    "title",
    "audience_tags",
    "source"
  ]
}
